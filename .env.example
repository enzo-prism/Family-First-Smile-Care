# Copy to your own environment (do not commit real secrets).
#
# Required for database persistence (contacts admin tab)
DATABASE_URL=

# Canonical host (optional)
CANONICAL_HOST=https://famfirstsmile.com

# Admin dashboard (HTTP Basic Auth)
ADMIN_PASSWORD=change-me

# Google Analytics (GA4)
GA4_PROPERTY_ID=518867337

# Google Search Console
# For the domain property shown as "famfirstsmile.com" in the UI, use the sc-domain prefix.
GSC_SITE_URL=sc-domain:famfirstsmile.com

# Google API credentials (choose ONE)
# 1) Base64-encoded service account JSON key
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# 2) Path to a service account JSON key file (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

